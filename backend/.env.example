# MedPulse HMS — Backend Environment Variables
# Copy this file to .env and fill in real values

# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB)
# MONGO_URI=mongodb://localhost:27017/medpulse_hms

# Auth
# JWT_SECRET=your_super_secret_key_here
# JWT_EXPIRES_IN=7d

# CORS
CLIENT_ORIGIN=http://localhost:5173

